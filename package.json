{
  "name": "dsh-reasoning-bridge",
  "version": "0.5.0",
  "description": "Reasoning Bridge for dsh: hand high-cost reasoning to web AI (ChatGPT or Arena AI, multi-target), keep local evidence, adoption gate, edits, and tests in dsh. Contract-based Packet/Result, versioned risk consent, executable browser transport (zero-dependency CDP driver), SHA-256 run receipts.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./web": "./lib/web.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": {
    "name": "shangdi178",
    "url": "https://github.com/shangdi178"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shangdi178/dsh-reasoning-bridge.git"
  },
  "homepage": "https://github.com/shangdi178/dsh-reasoning-bridge#readme",
  "bugs": {
    "url": "https://github.com/shangdi178/dsh-reasoning-bridge/issues"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "DESIGN.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "reasoning",
    "chatgpt",
    "arena",
    "browser-automation",
    "skill"
  ],
  "scripts": {
    "test": "node --test tests/bundle.test.mjs tests/consent.test.mjs tests/handoff.test.mjs tests/plugin.test.mjs tests/settings.test.mjs tests/target.test.mjs tests/transport.test.mjs tests/validate.test.mjs",
    "doctor": "node skills/reasoning-bridge/scripts/doctor.mjs --json",
    "validate": "node skills/reasoning-bridge/scripts/validate.mjs",
    "transport": "node skills/reasoning-bridge/scripts/transport.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
